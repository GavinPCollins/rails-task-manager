<div class="max-w-md mx-auto p-6">
  <%= link_to "Back", root_path, class: "underline text-gray-500" %>
  <h1 class="font-medium tracking-tight text-xl mb-6 p-4">Create Task</h1>
  <%= form_with model: @task do |f| %>
    <div class="space-y-5">
      <div>
        <%= f.label :title, "Task", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= f.text_field :title, placeholder: "Task title ...", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div>
        <%= f.label :details, class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= f.text_area :details, placeholder: "Task details ...", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>
      <%= f.button type: :submit, class: "w-full rounded-full bg-gray-800 px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-800" %>
    </div>
  <% end %>
</div>
